# 01 - Extrair cookies
#--cookies-from-browser chrome
#--cookies "D:\Downloads\ytcookies.txt"

# Videos antigos primeiro
--playlist-reverse

# 02 - Pasta de download dos vídeos
# Linux
-P '/home/dudu/Vídeos'

# Windows
#-P 'A:\'

# 03 - Saida do arquivo de vídeo
# Linux
-o "%(extractor)s/%(channel)s/%(playlist_title|)s/%(playlist_autonumber|)03d%(playlist_title& - |)s%(title)s.%(ext)s"

# Windows
#-o "%(extractor)s\%(channel)s\%(playlist_title|)s\%(playlist_autonumber|)03d%(playlist_title& - |)s%(title)s.%(ext)s"

# Incorporar capitulação no arquivo de video
--embed-chapters

# Incorporar miniatura como capa do vídeo/audio
--embed-thumbnail

# Sempre salvar em mkv
-t mkv

# Baixar seção do video
#--download-sections "*06:09:35-06:12:34"
